    "lint-staged": "^16.1.2",
    "prettier": "^3.6.2",
    "typescript": "^5.8.2"
  },
  "overrides": {
    "postcss": "8.5.28"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
